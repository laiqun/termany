# Termany configuration — copy to .env and adjust as needed.
# All values are optional; the defaults below match `npm run dev`.
#
# Model-provider API keys are NOT configured here — they are entered in the app
# (BYOK) and stored locally in ~/.termany/termany.db.

# --- Server (apps/server) ---
# PTY/API server port.
TERMANY_PORT=5174
# Directory where pasted images are written (defaults to the system temp dir).
# TERMANY_PASTE_DIR=

# --- Web client (apps/web, Vite) ---
# Where the web client reaches the PTY WebSocket and REST API.
VITE_PTY_URL=ws://localhost:5174
VITE_API_URL=http://localhost:5174
